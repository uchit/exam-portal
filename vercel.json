{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/certifications/ccar-p", "destination": "/ccar-p/exam", "permanent": true },
    { "source": "/certifications/ccao-f", "destination": "/ccao-f/exam", "permanent": true },
    { "source": "/certifications/ccdv-f", "destination": "/ccdv-f/exam", "permanent": true }
  ],
  "crons": [
    { "path": "/api/cron/freshness-check", "schedule": "0 13 * * *" }
  ],
  "functions": {
    "api/cron/freshness-check.js": { "includeFiles": "data/build-meta.json" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
    }
  ]
}
